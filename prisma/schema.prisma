generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  nickname  String?  // Added for compatibility with frontend register form
  phone     String   @unique
  email     String?
  password  String
  role      String   @default("USER") // ADMIN, USER
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tree {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  images      String   // JSON string of image URLs
  category    String
  status      String   @default("AVAILABLE") // AVAILABLE, BOOKED, SOLD
  tags        String   // Comma separated tags
  growthTime  String?  // e.g. "1-2 weeks"
  bookings    BookingItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Booking {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  items       BookingItem[]
  pickupDate  DateTime
  totalPrice  Float
  deposit     Float
  status      String   @default("PENDING") // PENDING, PAID, PREPARING, READY, COMPLETED, CANCELLED
  refCode     String   @unique
  slipUrl     String?
  note        String?  // Admin note or user note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  treeId    String
  tree      Tree     @relation(fields: [treeId], references: [id])
  quantity  Int
  price     Float    // Snapshot price at time of booking
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  bookingId String?  // Optional link to booking
  createdAt DateTime @default(now())
}
