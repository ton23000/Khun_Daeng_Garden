generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminNotification {
  id        String   @id
  message   String
  type      String   @default("order")
  read      Boolean  @default(false)
  bookingId String?
  createdAt DateTime @default(now())
  Booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Booking {
  id                String              @id
  userId            String
  pickupDate        DateTime
  totalPrice        Float
  deposit           Float
  paymentType       String              @default("deposit")
  status            String              @default("PENDING")
  refCode           String              @unique
  slipUrl           String?
  note              String?
  reviewable        Boolean             @default(false)
  isPreorder        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  AdminNotification AdminNotification[]
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  BookingItem       BookingItem[]
  Review            Review[]
}

model BookingItem {
  id        String  @id
  bookingId String
  treeId    String
  quantity  Int
  price     Float
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Tree      Tree    @relation(fields: [treeId], references: [id])
}

model Category {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Favorite {
  id        String   @id
  userId    String
  treeId    String
  createdAt DateTime @default(now())
  Tree      Tree     @relation(fields: [treeId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId])
}

model Notification {
  id        String   @id
  userId    String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  bookingId String?
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id
  userId     String
  treeId     String
  bookingId  String
  rating     Int
  comment    String?
  images     String?
  helpful    Int      @default(0)
  hidden     Boolean  @default(false)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  Tree       Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, treeId])
  @@index([treeId])
  @@index([userId])
}

model SiteSetting {
  id        String   @id
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Tree {
  id               String        @id
  name             String
  description      String
  price            Float
  images           String
  category         String
  status           String        @default("AVAILABLE")
  tags             String
  growthTime       String?
  stock            Int           @default(0)
  reserved         Int           @default(0)
  sold             Int           @default(0)
  rating           Float         @default(0)
  reviewCount      Int           @default(0)
  isPromotion      Boolean       @default(false)
  originalPrice    Float?
  promotionName    String?
  promotionEndDate DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  BookingItem      BookingItem[]
  Favorite         Favorite[]
  Review           Review[]
}

model User {
  id                String          @id
  firstName         String
  lastName          String
  phone             String          @unique
  email             String?         @unique
  password          String
  role              String          @default("USER")
  verified          Boolean         @default(false)
  verificationToken String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Booking           Booking[]
  Favorite          Favorite[]
  PasswordReset     PasswordReset[]
  Review            Review[]
}
